{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/ui/**",
              "docs/**",
              "ui_kits/**",
              "ui_kits/app/**",
              "ui_kits/web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Colo Pro|Bungee|Oswald))/i]",
        "message": "Font not provided by the design system. Available: Colo Pro, Bungee, Oswald."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:rosa|dorado|terracota|dark|quiet)$/]",
        "message": "<Badge> tone must be one of 'rosa' | 'dorado' | 'terracota' | 'dark' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|icon|iconAfter|block|disabled|stamped|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, tone, size, icon, iconAfter, block, disabled, stamped, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|dark|warm|outline|ghost)$/]",
        "message": "<Button> tone must be one of 'primary' | 'dark' | 'warm' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DotRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:colors|size|gap|style|key|ref|className|style|children)$/]",
        "message": "<DotRow> doesn't accept that prop. Declared props: colors, size, gap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|as|type|required|invalid|options|value|onChange|placeholder|rows|id|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, as, type, required, invalid, options, value, onChange, placeholder, rows, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|select|textarea)$/]",
        "message": "<Field> as must be one of 'input' | 'select' | 'textarea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FramedPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tape|padding|children|style|key|ref|className|style|children)$/]",
        "message": "<FramedPanel> doesn't accept that prop. Declared props: variant, tape, padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FramedPanel'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:object|info|paper|hero)$/]",
        "message": "<FramedPanel> variant must be one of 'object' | 'info' | 'paper' | 'hero'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FramedPanel'] > JSXAttribute[name.name='tape'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<FramedPanel> tape must be one of 'top' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|size|base|subtitle|tagline|align|style|key|ref|className|style|children)$/]",
        "message": "<Lockup> doesn't accept that prop. Declared props: variant, tone, size, base, subtitle, tagline, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lockup'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:pala|completo|ingredientes)$/]",
        "message": "<Lockup> variant must be one of 'pala' | 'completo' | 'ingredientes'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lockup'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:negro|hueso)$/]",
        "message": "<Lockup> tone must be one of 'negro' | 'hueso'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lockup'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Lockup> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|headBackground|children|style|key|ref|className|style|children)$/]",
        "message": "<MenuCard> doesn't accept that prop. Declared props: kicker, title, headBackground, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|description|price|photo|photoSize|badge|divider|action|onClick|style|key|ref|className|style|children)$/]",
        "message": "<MenuItem> doesn't accept that prop. Declared props: name, description, price, photo, photoSize, badge, divider, action, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QtyStepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|onChange|size|style|key|ref|className|style|children)$/]",
        "message": "<QtyStepper> doesn't accept that prop. Declared props: value, min, max, onChange, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|onChange|required|invalid|hint|columns|style|key|ref|className|style|children)$/]",
        "message": "<RadioGroup> doesn't accept that prop. Declared props: label, options, value, onChange, required, invalid, hint, columns, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|rule|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: children, color, rule, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:headline|kicker|treatment|background|headlineColor|kickerColor|style|key|ref|className|style|children)$/]",
        "message": "<SocialTile> doesn't accept that prop. Declared props: headline, kicker, treatment, background, headlineColor, kickerColor, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialTile'] > JSXAttribute[name.name='treatment'] > Literal[value!=/^(?:diagonal|flat)$/]",
        "message": "<SocialTile> treatment must be one of 'diagonal' | 'flat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stamp'] > JSXAttribute > JSXIdentifier[name!=/^(?:lines|size|color|tilt|style|key|ref|className|style|children)$/]",
        "message": "<Stamp> doesn't accept that prop. Declared props: lines, size, color, tilt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|children|icon|style|key|ref|className|style|children)$/]",
        "message": "<StatusNote> doesn't accept that prop. Declared props: tone, title, children, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusNote'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ok|warn|block)$/]",
        "message": "<StatusNote> tone must be one of 'ok' | 'warn' | 'block'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Swatch'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|hex|note|fill|height|style|key|ref|className|style|children)$/]",
        "message": "<Swatch> doesn't accept that prop. Declared props: name, hex, note, fill, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TapeStripe'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|position|style|key|ref|className|style|children)$/]",
        "message": "<TapeStripe> doesn't accept that prop. Declared props: height, position, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TapeStripe'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<TapeStripe> position must be one of 'top' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|vector|color|accent|tagline|subtitle|showSubtitle|print|align|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, vector, color, accent, tagline, subtitle, showSubtitle, print, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Wordmark> align must be one of 'left' | 'center'."
      }
    ]
  },
