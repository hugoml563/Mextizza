
# Capacitor mobile build artifact (regenerate with: npm run build:mobile)
/mobile-www/
/node_modules/
/android/app/build/
/android/.gradle/

# Firma de release — NUNCA subir: quien tenga la llave puede publicar
# actualizaciones falsas que Android acepte como legitimas.
/android/mextizza-release.keystore
/android/keystore.properties

# Cache del skill graphify: se regenera solo y son cientos de archivos.
/graphify-out/

# Ruta del SDK de Android: es de esta maquina, no del proyecto.
android/local.properties

# Andamios temporales de composicion de imagen y video. Se crean para una
# tarea y se borran; nunca deben viajar en el repositorio.
/.tmp-*/

# Configuracion de Firebase para Android. No es secreta (la misma clave va en
# el sitio), pero vive junto a la llave de firma: el APK solo se construye en
# la maquina que tiene las dos. Se vuelve a bajar de la consola de Firebase.
/android/app/google-services.json
