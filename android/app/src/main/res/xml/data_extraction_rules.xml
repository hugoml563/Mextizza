<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: excluye la app de las transferencias nube/dispositivo. Los datos
     del cliente (nombre, telefono, direccion) viven en el WebView y no deben salir
     del telefono. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
